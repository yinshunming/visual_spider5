<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback 配置（M1-5）：
  - 控制台 + 文件双输出
  - 文件滚动：单文件 10MB × 10 个文件 + 30 天归档
  - 自定义 MessageConverter 接入 LoggingScrubber 脱敏 password/Cookie/Authorization/XSRF-TOKEN/JSON 内 password|token
-->
<configuration>

    <conversionRule conversionWord="msg"
                    converterClass="com.visualspider.shared.logging.ScrubbingMessageConverter"/>
    <conversionRule conversionWord="message"
                    converterClass="com.visualspider.shared.logging.ScrubbingMessageConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="com.visualspider" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
</configuration>
